# Copy this file to .env. Never commit the populated .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Defaults are correct for local development. Render overrides HOST and PORT.
HOST=127.0.0.1
PORT=3001
AI_SERVICE_URL=http://127.0.0.1:8001
PUBLIC_ORIGINS=
NODE_ENV=development
